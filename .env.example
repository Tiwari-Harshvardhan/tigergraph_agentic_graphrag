# Copy to .env locally; never commit secrets.
TIGERGRAPH_HOST=
TIGERGRAPH_GRAPH=wikipedia_corpus
TIGERGRAPH_SECRET=

# LLM_PROVIDER=gemini, openai-compatible, huggingface, or ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_TEMPERATURE=0

# Hugging Face Inference Providers (OpenAI-compatible Router)
HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b:fastest
HF_BASE_URL=https://router.huggingface.co/v1

# Local Ollama (OpenAI-compatible chat endpoint)
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434

# Optional OpenAI-compatible provider settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Local embeddings used with TigerGraph vector search
EMBEDDING_MODEL=all-MiniLM-L6-v2

# TigerGraph health/readiness behavior
TIGERGRAPH_AUTO_START=false
TIGERGRAPH_START_TIMEOUT=300
TIGERGRAPH_POLL_INTERVAL=5
