CREATE QUERY event_aggregate(
  STRING p_operation,
  STRING p_sport,
  STRING p_edition,
  STRING p_discipline,
  STRING p_season,
  STRING p_competitor_op,
  UINT p_competitor_value,
  UINT p_year
) FOR GRAPH wikipedia_corpus {
  SumAccum<UINT> @@event_count;
  SumAccum<UINT> @@competitor_sum;
  MinAccum<UINT> @@competitor_min;
  MaxAccum<UINT> @@competitor_max;
  AvgAccum @@competitor_avg;

  matched_events = SELECT e
    FROM events:e
    WHERE (p_sport == "" OR e.sport == p_sport)
      AND (p_edition == "" OR e.edition == p_edition)
      AND (p_discipline == "" OR e.discipline == p_discipline)
      AND (p_season == "" OR e.season == p_season)
      AND (p_year == 0 OR e.year == p_year)
      AND (
        p_competitor_op == ""
        OR (p_competitor_op == ">" AND e.competitor_count > p_competitor_value)
        OR (p_competitor_op == ">=" AND e.competitor_count >= p_competitor_value)
        OR (p_competitor_op == "<" AND e.competitor_count < p_competitor_value)
        OR (p_competitor_op == "<=" AND e.competitor_count <= p_competitor_value)
        OR (p_competitor_op == "=" AND e.competitor_count == p_competitor_value)
      )
    ACCUM
      @@event_count += 1,
      @@competitor_sum += e.competitor_count,
      @@competitor_min += e.competitor_count,
      @@competitor_max += e.competitor_count,
      @@competitor_avg += e.competitor_count;

  PRINT p_operation AS operation,
    @@event_count AS total_count,
    @@competitor_sum AS competitor_sum,
    @@competitor_min AS competitor_min,
    @@competitor_max AS competitor_max,
    @@competitor_avg AS competitor_avg;
}